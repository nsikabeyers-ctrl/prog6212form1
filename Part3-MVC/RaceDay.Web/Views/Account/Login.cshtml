@model LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h1>Log in</h1>
        <p class="text-muted">Welcome back. Pick up where you left off.</p>

        <form asp-action="Login" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-alert"></div>
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <button type="submit" class="btn btn-rd-primary w-100">Log in</button>
        </form>

        <p class="auth-switch">New here? <a asp-action="Register">Create an account</a></p>
    </div>
</div>
