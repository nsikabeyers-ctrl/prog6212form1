@model EventFormViewModel
@{
    var isNew = Model.EventId is null;
}

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-alert"></div>

    <div class="row g-3">
        <div class="col-12">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="EventType" class="form-label"></label>
            <select asp-for="EventType" asp-items="Html.GetEnumSelectList<EventType>()" class="form-select">
                <option value="">Choose a type</option>
            </select>
            <span asp-validation-for="EventType" class="field-error"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="DistanceKm" class="form-label"></label>
            <input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" />
            <span asp-validation-for="DistanceKm" class="field-error"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="EventDate" class="form-label"></label>
            <input name="EventDate" id="EventDate" type="datetime-local" class="form-control"
                   value="@Model.EventDate?.ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="EventDate" class="field-error"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Location" class="form-label"></label>
            <input asp-for="Location" class="form-control" />
            <span asp-validation-for="Location" class="field-error"></span>
        </div>

        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" rows="4" class="form-control"></textarea>
            <span asp-validation-for="Description" class="field-error"></span>
        </div>

        <div class="col-12">
            <label asp-for="Banner" class="form-label"></label>
            @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
            {
                <div class="mb-2">
                    <img class="banner-preview" src="@Model.ExistingBannerUrl" alt="Current banner" />
                </div>
            }
            <input asp-for="Banner" type="file" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif" />
            <div class="form-text">JPG, PNG, WEBP or GIF, up to 2 MB. @(isNew ? "Optional." : "Leave empty to keep the current banner.")</div>
            <span asp-validation-for="Banner" class="field-error"></span>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-rd-primary">@(isNew ? "Create event" : "Save changes")</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>
