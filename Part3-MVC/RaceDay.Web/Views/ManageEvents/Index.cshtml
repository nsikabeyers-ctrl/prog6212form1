@model List<EventDto>
@{
    ViewData["Title"] = "Manage events";
}

<div class="page-head">
    <div>
        <span class="eyebrow">Organiser</span>
        <h1>Manage events</h1>
    </div>
    <a class="btn btn-rd-primary" asp-action="Create">Create an event</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <img src="/img/run.svg" alt="" />
        <h3>No events yet</h3>
        <p>Create your first event to get started.</p>
        <a class="btn btn-rd-primary" asp-action="Create">Create an event</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model)
        {
            <div class="col-md-6 col-xl-4">
                <article class="event-card h-100">
                    <partial name="_EventBanner" model="ev" />
                    <div class="event-card-body">
                        <div class="event-date">@Format.DateTimeFull(ev.EventDate)</div>
                        <h3 class="event-title">@ev.Name</h3>
                        <ul class="event-meta">
                            <li><span class="meta-label">Where</span> @ev.Location</li>
                            <li><span class="meta-label">Distance</span> @Format.Km(ev.DistanceKm)</li>
                            <li><span class="meta-label">Entries</span> @ev.EnrolmentCount</li>
                        </ul>
                        <div class="manage-actions mt-auto pt-3">
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="ManageCategories" asp-action="Index" asp-route-eventId="@ev.EventId">Categories</a>
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="ManageEnrolments" asp-action="Index" asp-route-eventId="@ev.EventId">Entries</a>
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="ManageResults" asp-action="Index" asp-route-eventId="@ev.EventId">Results</a>
                            <a class="btn btn-rd-primary btn-sm" asp-action="Edit" asp-route-id="@ev.EventId">Edit</a>
                            <form asp-action="Delete" method="post" onsubmit="return confirm('Delete @ev.Name? This cannot be undone.');" class="d-inline">
                                <input type="hidden" name="id" value="@ev.EventId" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
