@model List<ResultDto>
@{
    ViewData["Title"] = "My results";
}

<div class="page-head">
    <div>
        <span class="eyebrow">Participant</span>
        <h1>My results</h1>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <img src="/img/cycle.svg" alt="" />
        <h3>No results yet</h3>
        <p>Your finish times appear here once an organiser captures them.</p>
    </div>
}
else
{
    <div class="row g-4 mb-4">
        <div class="col-6 col-md-3"><div class="stat-card"><span>Races finished</span><b>@Model.Count</b></div></div>
        <div class="col-6 col-md-3"><div class="stat-card"><span>Podiums</span><b>@Model.Count(r => r.FinishPosition <= 3)</b></div></div>
        <div class="col-12 col-md-6"><div class="stat-card"><span>Best finish</span><b>@Format.Ordinal(Model.Min(r => r.FinishPosition))</b></div></div>
    </div>

    <div class="table-wrap">
        <table class="table rd-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Finish time</th>
                    <th>Position</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td><a class="table-link" asp-controller="Events" asp-action="Details" asp-route-id="@r.EventId">@r.EventName</a></td>
                        <td>@Format.Date(r.EventDate)</td>
                        <td>@r.CategoryName</td>
                        <td class="mono">@Format.Time(r.FinishTime)</td>
                        <td>
                            <span class="position @(r.FinishPosition <= 3 ? "podium" : "")">@Format.Ordinal(r.FinishPosition)</span>
                            <span class="text-muted small">of @r.TotalFinishers @(r.TotalFinishers == 1 ? "finisher" : "finishers")</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
