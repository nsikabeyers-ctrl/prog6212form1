@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-head">
    <div>
        <span class="eyebrow">Organiser</span>
        <h1>Dashboard</h1>
    </div>
    <a class="btn btn-rd-primary" asp-controller="ManageEvents" asp-action="Create">Create an event</a>
</div>

<div class="row g-4 mb-4">
    <div class="col-6 col-lg-3"><div class="stat-card"><span>Events</span><b>@Model.TotalEvents</b></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card"><span>Upcoming</span><b>@Model.UpcomingEvents</b></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card"><span>Entries</span><b>@Model.TotalEnrolments</b></div></div>
    <div class="col-6 col-lg-3">
        <div class="stat-card stat-card-accent">
            <span>Next event</span>
            @if (Model.NextEvent is { } next)
            {
                <b class="stat-small">@next.Name</b>
                <small>@Format.Date(next.EventDate)</small>
            }
            else
            {
                <b class="stat-small">None planned</b>
            }
        </div>
    </div>
</div>

<h2 class="section-title">Your events</h2>

@if (Model.Events.Count == 0)
{
    <div class="empty-state">
        <img src="/img/run.svg" alt="" />
        <h3>You have not created an event yet</h3>
        <p>Create your first event, add categories, then let people enter.</p>
        <a class="btn btn-rd-primary" asp-controller="ManageEvents" asp-action="Create">Create an event</a>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table rd-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Entries</th>
                    <th>When</th>
                    <th class="text-end">Manage</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model.Events)
                {
                    var upcoming = ev.EventDate > DateTime.UtcNow;
                    <tr>
                        <td>
                            <b>@ev.Name</b>
                            <div class="text-muted small">@ev.Location &middot; @Format.Km(ev.DistanceKm) &middot; @ev.EventType</div>
                        </td>
                        <td>@Format.Date(ev.EventDate)</td>
                        <td>@ev.EnrolmentCount</td>
                        <td><span class="time-badge @(upcoming ? "time-upcoming" : "time-past")">@(upcoming ? "Upcoming" : "Past")</span></td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-outline-secondary" asp-controller="ManageCategories" asp-action="Index" asp-route-eventId="@ev.EventId">Categories</a>
                                <a class="btn btn-outline-secondary" asp-controller="ManageEnrolments" asp-action="Index" asp-route-eventId="@ev.EventId">Entries</a>
                                <a class="btn btn-outline-secondary" asp-controller="ManageResults" asp-action="Index" asp-route-eventId="@ev.EventId">Results</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
