@model ManageCategoriesViewModel
@{
    var ev = Model.Event;
    ViewData["Title"] = "Categories";
}

<a class="back-link" asp-controller="ManageEvents" asp-action="Index">&larr; All events</a>

<div class="page-head mt-2">
    <div>
        <span class="eyebrow">Categories</span>
        <h1>@ev.Name</h1>
        <p class="text-muted mb-0">@Format.DateTimeFull(ev.EventDate) &middot; @ev.Location</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="ManageEnrolments" asp-action="Index" asp-route-eventId="@ev.EventId">See entries</a>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        @if (ev.Categories.Count == 0)
        {
            <div class="empty-state empty-state-sm">
                <h3>No categories yet</h3>
                <p>Participants can only enter once there is at least one category.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table rd-table align-middle mb-0">
                    <thead>
                        <tr><th>Category</th><th>Ages</th><th>Distance</th><th class="text-end"></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var c in ev.Categories)
                        {
                            <tr>
                                <td><b>@c.Name</b></td>
                                <td>@Format.AgeRange(c)</td>
                                <td>@(c.DistanceKm is decimal km ? Format.Km(km) : Format.Km(ev.DistanceKm))</td>
                                <td class="text-end">
                                    <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@c.CategoryId" asp-route-eventId="@ev.EventId">Edit</a>
                                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Remove @c.Name?');">
                                        <input type="hidden" name="id" value="@c.CategoryId" />
                                        <input type="hidden" name="eventId" value="@ev.EventId" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="panel">
            <h2 class="h5 mb-3">Add a category</h2>
            <form asp-action="Create" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-alert"></div>
                <input type="hidden" name="EventId" value="@ev.EventId" />

                <div class="mb-3">
                    <label asp-for="NewCategory.Name" class="form-label"></label>
                    <input asp-for="NewCategory.Name" class="form-control" placeholder="For example Under 18" />
                    <span asp-validation-for="NewCategory.Name" class="field-error"></span>
                </div>
                <div class="row g-3">
                    <div class="col-6">
                        <label asp-for="NewCategory.MinAge" class="form-label"></label>
                        <input asp-for="NewCategory.MinAge" type="number" min="0" max="120" class="form-control" />
                        <span asp-validation-for="NewCategory.MinAge" class="field-error"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="NewCategory.MaxAge" class="form-label"></label>
                        <input asp-for="NewCategory.MaxAge" type="number" min="0" max="120" class="form-control" />
                        <span asp-validation-for="NewCategory.MaxAge" class="field-error"></span>
                    </div>
                </div>
                <div class="mb-3 mt-3">
                    <label asp-for="NewCategory.DistanceKm" class="form-label"></label>
                    <input asp-for="NewCategory.DistanceKm" type="number" step="0.1" min="0.1" class="form-control" />
                    <div class="form-text">Leave empty to use the event distance.</div>
                    <span asp-validation-for="NewCategory.DistanceKm" class="field-error"></span>
                </div>
                <button type="submit" class="btn btn-rd-primary w-100">Add category</button>
            </form>
        </div>
    </div>
</div>
